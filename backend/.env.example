# ─────────────────────────────────────────────────────────────────
#  Vending Manager — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores reais
#  NUNCA versione o arquivo .env no repositório
# ─────────────────────────────────────────────────────────────────

# ── Aplicação ──────────────────────────────────────────────────
APP_ENV=development
APP_PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Banco de Dados (MySQL) ─────────────────────────────────────
DB_HOST=belcafe.mysql.dbaas.com.br
DB_PORT=3306
DB_NAME=belcafe
DB_USER=belcafe
DB_PASSWORD=SUA_SENHA_AQUI

# ── JWT ────────────────────────────────────────────────────────
# Gere valores fortes com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UM_SECRET_FORTE_AQUI
JWT_REFRESH_SECRET=GERE_OUTRO_SECRET_FORTE_AQUI
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── E-mail (SMTP) ──────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=seu_email@gmail.com
MAIL_PASS=sua_senha_de_app_gmail
MAIL_FROM="Vending Manager <noreply@vendingmanager.com.br>"

# ── Segurança de Login ─────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# ── (Produção apenas) ──────────────────────────────────────────
# DB_ROOT_PASSWORD=SENHA_ROOT_MYSQL_PRODUCAO
