{
  "name": "vendingmanager-api",
  "version": "1.0.0",
  "description": "Vending Manager SaaS — API Backend",
  "author": "BelCafé",
  "private": true,
  "scripts": {
    "build":       "nest build",
    "start":       "node dist/main",
    "start:dev":   "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint":        "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test":        "jest --config jest.config.ts --passWithNoTests",
    "test:watch":  "jest --config jest.config.ts --watch",
    "test:cov":    "jest --config jest.config.ts --coverage",
    "test:e2e":    "jest --config jest.config.ts --testRegex=\".e2e.spec.ts$\" --runInBand",
    "migrate":        "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "migrate:status": "ts-node -r tsconfig-paths/register src/database/migrate.ts --status",
    "migrate:reset":  "ts-node -r tsconfig-paths/register src/database/migrate.ts --reset",
    "migrate:retry":  "ts-node -r tsconfig-paths/register src/database/migrate.ts --retry"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/schedule": "^4.0.1",
    "typeorm": "^0.3.20",
    "mysql2": "^3.9.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "nodemailer": "^6.9.12",
    "exceljs": "^4.4.0",
    "rxjs": "^7.8.1",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.8",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
